# Raw downloaded source files -- regenerated by datasets/prep_*.py, not
# the normalized JSONL output (which IS committed, matching the
# gemma4_moe_benchmarks/datasets/*.jsonl convention: a fixed, reproducible
# eval set checked into the repo).
datasets/.cache/

# Experiment output -- regenerated by run_pipeline.py / analyze_results.py.
results/*
!results/.gitkeep

# Scratch directories used by ad-hoc local test scripts (mocked
# run_pipeline.py/analyze_results.py runs). Should always be cleaned up by
# the script itself, but ignored too as a safety net in case a script
# crashes before reaching its cleanup step.
_test_scratch*/
