# syntax=docker/dockerfile:1

ARG CUDA_VERSION=13.0.3
ARG PYTHON_VERSION=3.12
ARG UBUNTU_VERSION=22.04
ARG VLLM_VERSION=0.27.2.dev1
ARG VLLM_REPOSITORY=https://github.com/overwindows/vllm-msn.git
ARG VLLM_REF=feat/deepseek-v4-flash-0731

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS builder

ARG CUDA_VERSION
ARG PYTHON_VERSION
ARG VLLM_VERSION
ARG VLLM_REPOSITORY
ARG VLLM_REF
ARG MAX_JOBS=32
ARG NVCC_THREADS=2

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=8.0 \
    MAX_JOBS=${MAX_JOBS} \
    NVCC_THREADS=${NVCC_THREADS} \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    VLLM_TARGET_DEVICE=cuda \
    VLLM_VERSION_OVERRIDE=${VLLM_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        libnuma-dev \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-venv \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && /root/.local/bin/uv venv --python python${PYTHON_VERSION} /opt/venv

ENV PATH=/opt/venv/bin:/root/.local/bin:${PATH}

RUN git clone --depth 1 --branch "${VLLM_REF}" \
    "${VLLM_REPOSITORY}" /workspace

WORKDIR /workspace
RUN uv pip install . --torch-backend=auto

FROM nvidia/cuda:${CUDA_VERSION}-base-ubuntu${UBUNTU_VERSION} AS runtime

ARG CUDA_VERSION
ARG PYTHON_VERSION

LABEL org.opencontainers.image.title="DeepSeek-V4-Flash-0731 on vLLM for A100" \
      org.opencontainers.image.description="Experimental SM80 vLLM backend for DeepSeek-V4-Flash-0731" \
      com.deepseek-v4-a100.cuda.version="${CUDA_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libnuma-dev \
        numactl \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        cuda-nvcc-13-0 \
        cuda-nvrtc-13-0 \
        cuda-cuobjdump-13-0 \
        libcublas-dev-13-0 \
        libcurand-dev-13-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

ENV PATH=/opt/venv/bin:${PATH} \
    CUDA_HOME=/usr/local/cuda \
    HF_HOME=/data/huggingface \
    VLLM_CACHE_ROOT=/data/vllm \
    TRITON_CACHE_DIR=/data/triton \
    VLLM_MARLIN_FP8_DEQUANT_BF16=1 \
    VLLM_MHC_POST_FUSE_SQRSUM=0 \
    VLLM_MHC_AR_INT8=0 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_REQUIRE_CUDA="cuda>=13.0" \
    PYTHONUNBUFFERED=1

RUN mkdir -p "${HF_HOME}" "${VLLM_CACHE_ROOT}" "${TRITON_CACHE_DIR}" \
    && python -c "import vllm; print(vllm.__version__)"

VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30m --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["vllm", "serve"]
CMD ["deepseek-ai/DeepSeek-V4-Flash-0731", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--trust-remote-code", \
     "--tensor-parallel-size", "8", \
     "--enable-expert-parallel", \
     "--moe-backend", "marlin", \
     "--kv-cache-dtype", "fp8", \
     "--block-size", "256", \
     "--max-model-len", "8192", \
     "--gpu-memory-utilization", "0.90", \
     "--tokenizer-mode", "deepseek_v4", \
     "--enable-auto-tool-choice", \
     "--tool-call-parser", "deepseek_v4", \
     "--reasoning-parser", "deepseek_v4", \
     "--speculative-config", "{\"method\":\"dspark\",\"num_speculative_tokens\":7,\"draft_sample_method\":\"greedy\"}"]
